# An installation's settings are one environment file of NAME=value lines:
# AT_MCP_ACCOUNTS_FILE, AT_MCP_STATE_DIR, RELEASE_COOKIE, AT_MCP_DIST_PORT and the
# rest (docs/operations.md, "Settings"). The service unit loads it for the service. A command
# run from a shell -- `at_mcp-accounts`, `rpc`, `remote`, `eval` -- loads it here
# when AT_MCP_ENV_FILE names it, so it reaches the service with the service's own
# settings. A file that is named but cannot be read stops the command rather
# than letting it run without its settings. Its output goes to stderr, so a
# command's own output (`at_mcp-accounts` prints JSON) stays clean.
if [ -n "${AT_MCP_ENV_FILE:-}" ]; then
  case "$AT_MCP_ENV_FILE" in
    /*) ;;
    *)
      echo "AT_MCP_ENV_FILE must be an absolute path, not $AT_MCP_ENV_FILE" >&2
      exit 64
      ;;
  esac
  if [ ! -r "$AT_MCP_ENV_FILE" ]; then
    echo "AT_MCP_ENV_FILE names $AT_MCP_ENV_FILE, which cannot be read" >&2
    exit 66
  fi
  set -a
  . "$AT_MCP_ENV_FILE" >&2
  set +a
fi

# Erlang distribution is AtMcp's local control channel for `rpc` and `remote`
# (`at_mcp-accounts status`, `reload`, `disconnect`, `reconnect`), never a transport
# to another machine, and it uses no port mapper (epmd). The service listens
# on 127.0.0.1 at AT_MCP_DIST_PORT, 4370 unless the environment file sets
# another; `rpc` and `remote` connect straight to that port and listen on
# nothing themselves (vm.args, remote.vm.args). A second installation on one
# machine sets its own AT_MCP_DIST_PORT and RELEASE_NODE. The port goes first in
# ELIXIR_ERL_OPTIONS because the first of two settings wins, and one inherited
# from another release's process must not. `eval` starts no distribution and
# gets no port. The node still offers its name to a port
# mapper on 127.0.0.1 if one happens to be running, as OTP does, and carries on
# when none is. A node name without a host is given a loopback one
# (`localhost`, or `127.0.0.1` for long names): the default host is the
# machine's hostname, which can resolve to a network address where nothing
# listens. An environment file or the caller may set any of these.
AT_MCP_DIST_PORT="${AT_MCP_DIST_PORT:-4370}"
case "${RELEASE_COMMAND:-}" in
  start* | daemon* | rpc | remote | stop | restart | pid)
    # A command that uses distribution needs this installation's own cookie.
    # Without one the release script falls back to releases/COOKIE, which
    # every copy of a published release carries and anyone who downloads it
    # can read, so an empty or missing RELEASE_COOKIE stops the command.
    if [ -z "${RELEASE_COOKIE:-}" ]; then
      echo "RELEASE_COOKIE is empty or not set. Set this installation's own in its environment file, from: openssl rand -hex 32" >&2
      exit 78
    fi
    ELIXIR_ERL_OPTIONS="-kernel erl_epmd_node_listen_port $AT_MCP_DIST_PORT${ELIXIR_ERL_OPTIONS:+ $ELIXIR_ERL_OPTIONS}"
    export ELIXIR_ERL_OPTIONS
    ;;
esac
RELEASE_NODE="${RELEASE_NODE:-$RELEASE_NAME}"
case "$RELEASE_NODE" in
  *@*) ;;
  *)
    if [ "${RELEASE_DISTRIBUTION:-sname}" = name ]; then
      RELEASE_NODE="$RELEASE_NODE@127.0.0.1"
    else
      RELEASE_NODE="$RELEASE_NODE@localhost"
    fi
    ;;
esac
export RELEASE_NODE

# A BEAM started without a UTF-8 locale opens its standard streams as latin1,
# and any UTF-8 it prints raises {:no_translation, :unicode, :latin1}. Supply
# one when the environment has none; a UTF-8 locale already set is kept.
case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
  *UTF-8 | *utf8 | *UTF8 | *utf-8) ;;
  *)
    # C.UTF-8 is the UTF-8 locale every glibc and musl system has; macOS has
    # none by that name.
    case "$(uname -s)" in
      Darwin) LANG=en_US.UTF-8 ;;
      *) LANG=C.UTF-8 ;;
    esac
    LC_ALL=$LANG
    export LANG LC_ALL
    ;;
esac
