# The environment file of one AtMcp installation: NAME=value lines, no `export`,
# and a value with a space in it double-quoted. The service's unit loads it
# (README, "Run it"); a command run from a shell loads it when AT_MCP_ENV_FILE
# names it. Readable by the service alone (0600, or 0640 root:at_mcp). Accounts
# themselves live in the accounts file that `at_mcp-accounts` manages, not here.
# docs/operations.md explains each variable.
AT_MCP_ACCOUNTS_FILE=/var/lib/at_mcp/accounts.json
AT_MCP_STATE_DIR=/var/lib/at_mcp
# openssl rand -hex 32. A published release's own cookie is readable by
# anyone who downloads it.
RELEASE_COOKIE=
# AT_MCP_DIST_PORT=4370
# One MCP endpoint serves every account; the grant a client presents selects
# the identity.
# AT_MCP_PORT=4400
# AT_MCP_CONTROL_PORT=4410
# AT_MCP_NETWORK=bluesky

# Each account's write quota: publishing writes (post, reply, repost) per
# window. Defaults shown; a value that is not a positive integer refuses to start.
# AT_MCP_WRITE_LIMIT=16
# AT_MCP_WRITE_WINDOW_SECONDS=3600

# Collection defaults: account notifications every 60 seconds; no firehose.
# AT_MCP_NOTIFICATIONS=0  # Disable background collection.
# AT_MCP_JETSTREAM=1      # Opt in to network-wide traffic, filtered locally.
# AT_MCP_NOTIFICATIONS_INTERVAL_SECONDS=60

# Undelivered events held for a consumer: per account, and the whole store in
# bytes (one account may fill a quarter). Defaults shown; a value that is not a
# positive integer refuses to start.
# AT_MCP_INBOUND_MAX_EVENTS=10000
# AT_MCP_INBOUND_MAX_BYTES=67108864

# Optional delivery to a durable consumer (Dwell, Haven, or your own host):
# AT_MCP_DELIVERY_URL=http://127.0.0.1:4401/inbound
# AT_MCP_DELIVERY_TOKEN_FILE=/etc/at_mcp/delivery-token

# Only for an installation that has no accounts file yet: read once, at
# startup, to write one, and never consulted again afterwards.
# BLUESKY_HANDLE=your.handle
# BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# BLUESKY_SERVICE=https://your-pds.example
# BLUESKY_HANDLE_2=second.handle
# BLUESKY_APP_PASSWORD_2=yyyy-yyyy-yyyy-yyyy
# BLUESKY_SERVICE_2=https://another-pds.example

# A second installation on the same machine (for example, another network)
# needs its own node name, distribution port and MCP port:
# RELEASE_NODE=at_mcp_delve
