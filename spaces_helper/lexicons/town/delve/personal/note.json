{
  "lexicon": 1,
  "id": "town.delve.personal.note",
  "defs": {
    "main": {
      "type": "record",
      "description": "A note in its author's personal space (town.delve.space.personal).",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["text", "createdAt"],
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 100000,
            "maxGraphemes": 50000,
            "description": "The note's text. Markdown is allowed."
          },
          "title": { "type": "string", "maxLength": 3000, "maxGraphemes": 300 },
          "tags": {
            "type": "array",
            "maxLength": 16,
            "items": { "type": "string", "maxLength": 640, "maxGraphemes": 64 }
          },
          "createdAt": { "type": "string", "format": "datetime" },
          "updatedAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
